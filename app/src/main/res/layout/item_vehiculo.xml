<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@color/adminya_surface"
    app:cardCornerRadius="19dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/adminya_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardBackgroundColor="#F0E7F7"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🚐"
                    android:textSize="29sp" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_placa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="V6X-123"
                    android:textColor="@color/adminya_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="V6X-123" />

                <TextView
                    android:id="@+id/tv_tipo_marca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Minivan · Toyota"
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="13sp"
                    tools:text="Minivan · Toyota" />

                <TextView
                    android:id="@+id/tv_modelo_anio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hiace · 2025"
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="12sp"
                    tools:text="Hiace · 2025" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/adminya_success"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="ACTIVO"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/adminya_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_capacidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Capacidad: 15 pasajeros"
                android:textColor="@color/adminya_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Capacidad: 15 pasajeros" />

            <TextView
                android:id="@+id/tv_disponibilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disponible"
                android:textColor="@color/adminya_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Disponible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Color: Blanco"
            android:textColor="@color/adminya_text_secondary"
            android:textSize="12sp"
            tools:text="Color: Blanco" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_editar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="EDITAR"
                android:textColor="@color/adminya_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/adminya_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cambiar_estado"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="CAMBIAR ESTADO"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/adminya_primary"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>