<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@color/adminya_surface"
    app:cardCornerRadius="19dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/adminya_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="17dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardBackgroundColor="#FFF0D6"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👩‍💼"
                    android:textSize="28sp" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="María López Flores"
                    android:textColor="@color/adminya_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="María López Flores" />

                <TextView
                    android:id="@+id/tv_dni_celular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="DNI: 74125896 · 987654321"
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="12sp"
                    tools:text="DNI: 74125896 · 987654321" />

                <TextView
                    android:id="@+id/tv_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="vendedor@gmail.com"
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="12sp"
                    tools:text="vendedor@gmail.com" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/adminya_success"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="ACTIVO"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="@color/adminya_border" />

        <TextView
            android:id="@+id/tv_acceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Puede ingresar al panel de ventas"
            android:textColor="@color/adminya_success"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_editar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="EDITAR"
                android:textColor="@color/adminya_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/adminya_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cambiar_estado"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="CAMBIAR ESTADO"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="@color/adminya_primary"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restablecer_password"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="ENVIAR CAMBIO DE CONTRASEÑA"
            android:textColor="@color/adminya_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/adminya_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>