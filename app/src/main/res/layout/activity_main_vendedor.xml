<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adminya_background"
    tools:context=".MainVendedorActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/adminya_primary_dark"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="27dp"
                android:paddingEnd="18dp"
                android:paddingBottom="25dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_saludo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hola, vendedor"
                            android:textColor="@android:color/white"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            tools:text="Hola, María" />

                        <TextView
                            android:id="@+id/tv_empresa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Cargando empresa..."
                            android:textColor="#D9FFFFFF"
                            android:textSize="15sp"
                            tools:text="Golden Janos" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cerrar_sesion"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="SALIR"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    app:cardBackgroundColor="#2EFFFFFF"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="VENDEDOR"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- CONTENIDO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="21dp"
                android:paddingEnd="18dp"
                android:paddingBottom="38dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Panel de operaciones"
                        android:textColor="@color/adminya_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_actualizar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="ACTUALIZAR"
                        android:textColor="@color/adminya_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Controla los viajes y la carga de pasajeros."
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="13sp" />

                <!-- RESUMEN -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/adminya_surface"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/adminya_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_choferes_disponibles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/adminya_success"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center"
                                android:text="Choferes disponibles"
                                android:textColor="@color/adminya_text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/adminya_surface"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/adminya_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_viajes_activos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/adminya_primary"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center"
                                android:text="Viajes activos"
                                android:textColor="@color/adminya_text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/adminya_surface"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/adminya_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_reservas_activas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/adminya_warning"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center"
                                android:text="Pasajeros"
                                android:textColor="@color/adminya_text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- TÍTULO VIAJE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Viaje en operación"
                    android:textColor="@color/adminya_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Viaje que actualmente está cargando o en recorrido."
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="13sp" />

                <!-- SIN VIAJE -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contenedor_sin_viaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/adminya_surface"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/adminya_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="27dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚐"
                            android:textSize="42sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="No hay viajes activos"
                            android:textColor="@color/adminya_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mensaje_sin_viaje"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Crea un viaje para comenzar a cargar pasajeros."
                            android:textColor="@color/adminya_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- VIAJE ACTUAL -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contenedor_viaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/adminya_surface"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/adminya_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="19dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_ruta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Aplao → Arequipa"
                                    android:textColor="@color/adminya_text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_fecha_hora"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="Hoy · 10:30 a. m."
                                    android:textColor="@color/adminya_text_secondary"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_estado_viaje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/adminya_warning"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tv_estado_viaje"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="11dp"
                                    android:paddingTop="7dp"
                                    android:paddingEnd="11dp"
                                    android:paddingBottom="7dp"
                                    android:text="CARGANDO"
                                    android:textColor="@android:color/white"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/adminya_border" />

                        <TextView
                            android:id="@+id/tv_chofer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:text="Chofer: No asignado"
                            android:textColor="@color/adminya_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_vehiculo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Vehículo: No asignado"
                            android:textColor="@color/adminya_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_placa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Placa: No registrada"
                            android:textColor="@color/adminya_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_ocupacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Ocupación: 0 de 4 pasajeros"
                            android:textColor="@color/adminya_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="17dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_controlar_carga"
                                android:layout_width="0dp"
                                android:layout_height="54dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="CONTROLAR"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/adminya_primary"
                                app:cornerRadius="15dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_vender_pasaje"
                                android:layout_width="0dp"
                                android:layout_height="54dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="VENDER PASAJE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/adminya_success"
                                app:cornerRadius="15dp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_lista_pasajeros"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="53dp"
                            android:layout_marginTop="11dp"
                            android:text="VER LISTA DE PASAJEROS"
                            android:textColor="@color/adminya_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="15dp"
                            app:strokeColor="@color/adminya_primary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- OPCIONES -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Operaciones"
                    android:textColor="@color/adminya_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accesos disponibles para el vendedor."
                    android:textColor="@color/adminya_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_crear_viaje"
                    android:layout_width="match_parent"
                    android:layout_height="57dp"
                    android:layout_marginTop="17dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:text="➕   CREAR NUEVO VIAJE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/adminya_primary"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_choferes_disponibles"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="57dp"
                    android:layout_marginTop="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:text="🚕   VER CHOFERES DISPONIBLES"
                    android:textColor="@color/adminya_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/adminya_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_viajes"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="57dp"
                    android:layout_marginTop="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:text="🚌   VER TODOS LOS VIAJES"
                    android:textColor="@color/adminya_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/adminya_primary" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- CARGANDO -->

    <FrameLayout
        android:id="@+id/contenedor_cargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/adminya_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="25dp">

                <ProgressBar
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:indeterminateTint="@color/adminya_primary" />

                <TextView
                    android:id="@+id/tv_mensaje_cargando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:text="Cargando operaciones..."
                    android:textColor="@color/adminya_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</FrameLayout>